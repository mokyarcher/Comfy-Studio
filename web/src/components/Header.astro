---
import { withBase } from '../lib/paths'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const baseTrim = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
const links = [
  { href: `${withBase()}#intro`, label: '介绍', match: '/' },
  { href: withBase('demo'), label: '演示', match: '/demo' },
  { href: withBase('deploy'), label: '部署', match: '/deploy' },
  { href: withBase('download'), label: '下载', match: '/download' },
  { href: withBase('models'), label: '模型', match: '/models' }
]

function isActive(match: string) {
  const normalized = path.startsWith(baseTrim) ? path.slice(baseTrim.length) || '/' : path
  if (match === '/') return normalized === '/' || normalized === ''
  return normalized === match || normalized.startsWith(match + '/')
}
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-bg/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={withBase()} class="group flex items-center gap-2.5">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-md border border-accent/30 bg-accent/10 text-sm font-semibold text-accent"
        aria-hidden="true"
      >
        C
      </span>
      <span class="display text-lg tracking-tight text-text group-hover:text-accent transition-colors">
        Comfy Studio
      </span>
    </a>

    <nav class="hidden items-center gap-1 sm:flex" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors',
              isActive(link.match)
                ? 'text-accent'
                : 'text-muted hover:bg-panel hover:text-text'
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/mokyarcher/Comfy-Studio"
        class="btn-secondary !px-3 !py-1.5 text-xs"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a href={withBase('download')} class="btn-primary !px-3 !py-1.5 text-xs sm:!px-4 sm:!py-2 sm:text-sm">
        下载
      </a>
    </div>
  </div>

  <nav
    class="flex gap-1 overflow-x-auto border-t border-border/60 px-4 py-2 sm:hidden"
    aria-label="移动导航"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'shrink-0 rounded-md px-3 py-1 text-sm',
            isActive(link.match) ? 'bg-accent/15 text-accent' : 'text-muted'
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
