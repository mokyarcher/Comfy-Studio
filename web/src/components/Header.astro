---
import { withBase } from '../lib/paths'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const baseTrim = (import.meta.env.BASE_URL || '/').replace(/\/$/, '')
const links = [
  { href: withBase(), label: '欢迎', match: '/' },
  { href: withBase('intro'), label: '介绍', match: '/intro' },
  { href: withBase('demo'), label: '演示', match: '/demo' },
  { href: withBase('deploy'), label: '部署', match: '/deploy' },
  { href: withBase('download'), label: '下载', match: '/download' },
  { href: withBase('workflows'), label: '工作流', match: '/workflows' }
]

function isActive(match: string) {
  const normalized = path.startsWith(baseTrim) ? path.slice(baseTrim.length) || '/' : path
  if (match === '/') return normalized === '/' || normalized === ''
  return normalized === match || normalized.startsWith(match + '/')
}
---

<header class="glass-nav">
  <div class="container-page relative flex h-[4.25rem] items-center">
    <a href={withBase()} class="group relative z-10 flex items-center gap-2.5">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-md bg-accent/15 text-sm font-semibold text-accent shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--color-accent)_35%,transparent)]"
        aria-hidden="true"
      >
        C
      </span>
      <span class="display text-lg tracking-tight text-text group-hover:text-accent transition-colors">
        Comfy Studio
      </span>
    </a>

    <nav
      class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-1.5 sm:flex"
      aria-label="主导航"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-3.5 py-2 text-base font-medium transition-colors',
              isActive(link.match)
                ? 'bg-white/10 text-accent shadow-[inset_0_0_0_1px_rgba(255,255,255,0.16)]'
                : 'text-muted hover:bg-white/[0.06] hover:text-text'
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <nav
    class="flex gap-1 overflow-x-auto border-t border-white/10 px-4 py-2.5 sm:hidden"
    aria-label="移动导航"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'shrink-0 rounded-md px-3.5 py-1.5 text-base font-medium',
            isActive(link.match) ? 'bg-white/10 text-accent' : 'text-muted'
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
