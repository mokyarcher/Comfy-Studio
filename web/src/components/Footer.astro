---
import { withBase } from '../lib/paths'

const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container-page">
    <div class="site-footer-bar glass-soft">
      <p class="display shrink-0 text-[0.95rem] leading-none text-text">Comfy Studio</p>
      <div class="site-footer-meta">
        <span>© {year}</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
          鄂ICP备2026015426号
        </a>
      </div>
      <nav class="site-footer-nav" aria-label="页脚">
        <a href={withBase('intro')}>介绍</a>
        <a href={withBase('demo')}>演示</a>
        <a href={withBase('deploy')}>部署</a>
        <a href={withBase('download')}>下载</a>
        <a href={withBase('workflows')}>工作流</a>
        <a href={withBase('about')}>关于</a>
        <a
          href="https://github.com/mokyarcher/Comfy-Studio"
          target="_blank"
          rel="noopener noreferrer"
        >
          源码
        </a>
      </nav>
    </div>
  </div>
</footer>
