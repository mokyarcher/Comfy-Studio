---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Reveal } from '../components/Reveal'
import { ArchDiagram } from '../components/ArchDiagram'

const modes = [
  {
    title: '文生图',
    body: 'Qwen 工作流，异步任务队列，结果落本地画廊。'
  },
  {
    title: '图编辑',
    body: '底图 / 参考图注入；提示词支持 <image1> / <image2>。'
  },
  {
    title: '图生视频',
    body: 'Wan TI2V：起始图 + 镜头提示，超时更长、进度可跟。'
  }
]

const trusts = [
  { title: '本地 GPU', body: '推理永不离开你的显卡' },
  { title: 'API Key', body: '鉴权与配额在服务端' },
  { title: '展馆', body: '分享作品，复用参数' }
]
---

<BaseLayout
  title="产品介绍"
  description="三种生成模式、本地 GPU 与云端入口架构：Comfy Studio 能力总览。"
>
  <section id="intro" class="container-page scroll-mt-24 py-14 sm:py-16">
    <Reveal client:visible>
      <p class="eyebrow">能力</p>
      <h1 class="section-title mt-3">三种生成模式，一套客户端</h1>
      <p class="section-lead">Studio 覆盖创作全流程；Gateway 守住本机服务与账号体系。</p>
    </Reveal>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        modes.map((mode, i) => (
          <Reveal client:visible delay={i * 0.06}>
            <article class="glass-panel h-full rounded-xl p-5 transition hover:shadow-[0_16px_40px_rgba(0,0,0,0.35)]">
              <h2 class="display text-xl text-text">{mode.title}</h2>
              <p class="mt-2 text-sm text-muted">{mode.body}</p>
            </article>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section class="container-page py-12 sm:py-14">
    <div class="grid gap-4 sm:grid-cols-3">
      {
        trusts.map((t, i) => (
          <Reveal client:visible delay={i * 0.05}>
            <div class="glass-soft rounded-xl px-5 py-4">
              <p class="text-sm font-medium text-accent">{t.title}</p>
              <p class="mt-1 text-sm text-muted">{t.body}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section class="container-page pb-6 pt-4">
    <Reveal client:visible>
      <p class="eyebrow">架构</p>
      <h2 class="section-title mt-3">云端入口，本地算力</h2>
      <p class="section-lead">Studio → HTTPS / Nginx → FRP → 本机 FastAPI → ComfyUI → GPU。</p>
    </Reveal>
    <div class="mt-10">
      <ArchDiagram client:visible />
    </div>
  </section>
</BaseLayout>
