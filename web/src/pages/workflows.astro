---
import BaseLayout from '../layouts/BaseLayout.astro'
import { MirrorCards, WorkflowList } from '../components/WorkflowCatalog'
import { Reveal } from '../components/Reveal'
import workflowsJson from '../data/workflows.json'
import type { WorkflowsManifest } from '../data/workflows'
import { withBase } from '../lib/paths'

const manifest = workflowsJson as WorkflowsManifest
---

<BaseLayout
  title="工作流"
  description="按工作流下载所需模型权重。国内镜像：魔搭优先，HF Mirror 备选。"
>
  <section class="container-page pb-6 pt-16 sm:pt-20">
    <Reveal client:visible>
      <p class="eyebrow">工作流</p>
      <h1 class="section-title hero-glass-title mt-3">工作流与模型</h1>
      <p class="section-lead">
        {manifest.intro || '按工作流拿齐权重。国内优先魔搭，HF Mirror 备选。'}
      </p>
    </Reveal>

    <div class="mt-10">
      <h2 class="mb-4 text-sm font-medium text-text">国内下载站</h2>
      <MirrorCards client:load manifest={manifest} />
    </div>

    <div class="mt-14">
      <Reveal client:visible>
        <h2 class="section-title hero-glass-title !text-2xl">本项目工作流</h2>
        <p class="section-lead">每个工作流下列出所需模型与下载入口。</p>
      </Reveal>
      <div class="mt-8">
        <WorkflowList client:visible manifest={manifest} />
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={withBase('deploy')} class="btn-secondary">部署方案</a>
      <a href={withBase('download')} class="btn-secondary">客户端下载</a>
    </div>
  </section>
</BaseLayout>
