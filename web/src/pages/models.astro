---
import BaseLayout from '../layouts/BaseLayout.astro'
import { MirrorCards, ProjectModels } from '../components/ModelList'
import { Reveal } from '../components/Reveal'
import modelsJson from '../data/models.json'
import type { ModelsManifest } from '../data/models'
import { withBase } from '../lib/paths'

const manifest = modelsJson as ModelsManifest
---

<BaseLayout
  title="模型"
  description="国内镜像（魔搭 / HF Mirror）与本项目所需大模型下载清单，方便部署者快速拿齐权重。"
>
  <section class="container-page py-16 sm:py-20">
    <Reveal client:visible>
      <p class="eyebrow">模型</p>
      <h1 class="section-title mt-3">快速拿齐权重</h1>
      <p class="section-lead">
        {manifest.intro ||
          '国内优先魔搭；HF Mirror 作备选。本项目条目维护在 web/src/data/models.json。'}
      </p>
      <p class="mt-3 font-mono text-xs text-muted">
        项目版本 {manifest.projectVersion}
        {manifest.updatedAt ? ` · 更新于 ${manifest.updatedAt}` : ''}
      </p>
    </Reveal>

    <div class="mt-10">
      <h2 class="mb-4 text-sm font-medium text-text">国内下载站</h2>
      <MirrorCards client:load manifest={manifest} />
    </div>

    <div class="mt-14">
      <Reveal client:visible>
        <h2 class="section-title !text-2xl">本项目模型</h2>
        <p class="section-lead">
          填好
          <code class="font-mono text-accent">links[].url</code>
          后，部署者可一键跳转下载，并按
          <code class="font-mono text-accent">savePath</code>
          放到本机 ComfyUI。
        </p>
      </Reveal>
      <div class="mt-8">
        <ProjectModels client:visible manifest={manifest} />
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={withBase('deploy')} class="btn-secondary">部署方案</a>
      <a href={withBase('download')} class="btn-secondary">客户端下载</a>
    </div>
  </section>
</BaseLayout>
