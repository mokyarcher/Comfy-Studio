---
import BaseLayout from '../layouts/BaseLayout.astro'
import { DemoPanel } from '../components/DemoPanel'
import { ShowcaseWall } from '../components/ShowcaseWall'
import { Reveal } from '../components/Reveal'
import showcase from '../data/showcase.json'
import demoJson from '../data/demo.json'
import type { ShowcaseItem } from '../data/showcase'
import type { DemoManifest } from '../data/demo'

const items = showcase as ShowcaseItem[]
const demo = demoJson as DemoManifest
---

<BaseLayout
  title="演示"
  description="Comfy Studio 产品导览：创作、队列、画廊、展馆与 Gateway 运维。"
>
  <section class="container-page py-16 sm:py-20">
    <Reveal client:visible>
      <p class="eyebrow">演示</p>
      <h1 class="section-title mt-3">从创作到展馆</h1>
      <p class="section-lead">点左侧功能查看对应截图，也可切换到视频导览。</p>
    </Reveal>

    <div class="mt-12">
      <DemoPanel client:load manifest={demo} />
    </div>
  </section>

  <section class="container-page pb-20">
    <Reveal client:visible>
      <h2 class="section-title">样例作品墙</h2>
      <p class="section-lead">精选生成效果，感受本机算力出图质感。</p>
    </Reveal>
    <div class="mt-8">
      <ShowcaseWall client:visible items={items} />
    </div>
  </section>
</BaseLayout>
