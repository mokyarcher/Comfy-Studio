# Empty = same-origin (dev proxy or nginx /v1). Set for cross-origin API.
# Production deploy MUST leave this empty (same-origin → app nginx split).
# Hardcoding the GPU FRP host (qwen-image-2-1) breaks Meta-only APIs like 查看译文.
# VITE_API_BASE=https://qwen-image-2-1.sharex.team
VITE_API_BASE=

# Optional: override Vite dev proxy target (default http://127.0.0.1:8000)
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
