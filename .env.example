HOST=127.0.0.1
PORT=8000

# Business-system isolation (shared cloud host / FRP). Relocates data/* → data/instances/{id}/
INSTANCE_ID=default
# false = cloud meta data plane (auth / prompts / works / gallery / showcase); no ComfyUI
ENABLE_GENERATION=true

COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=30
COMFYUI_POLL_INTERVAL_SECONDS=1.5
COMFYUI_JOB_TIMEOUT_SECONDS=900

# Change this before any real use. Keep it out of git and logs.
API_KEY=change-me-to-a-long-random-string

# Runtime paths below are relative to data/ and auto-namespaced by INSTANCE_ID.
DATABASE_PATH=data/tasks.db
IMAGE_OUTPUT_DIR=data/images
PROMPT_LIBRARY_PATH=data/prompt_library.json
SHARED_PROMPTS_DB_PATH=data/shared_prompts.db
TRANSLATE_CACHE_DB_PATH=data/translate_cache.db
WORKS_DB_PATH=data/works.db
# Prefer multi-bundle layout: llm_workflow/txt2img/<id>/{workflow_api,workflow_mapping,meta}.json
# Flat paths below remain as fallback when the txt2img/ scan finds nothing.
WORKFLOW_PATH=llm_workflow/workflow_api.json
WORKFLOW_MAPPING_PATH=llm_workflow/workflow_mapping.json
# Qwen Image Edit (multi-ref). Converted from llm_workflow/image_qwen_image_2_1_image_edit.json
IMAGE_EDIT_WORKFLOW_PATH=llm_workflow/workflow_image_edit_api.json
IMAGE_EDIT_WORKFLOW_MAPPING_PATH=llm_workflow/workflow_image_edit_mapping.json
# Wan 2.2 TI2V (from llm_workflow/video_wan2_2_5B_ti2v.json via scripts/convert_wan_ti2v_ui_to_api.py)
IMAGE_TO_VIDEO_WORKFLOW_PATH=llm_workflow/workflow_image_to_video_api.json
IMAGE_TO_VIDEO_WORKFLOW_MAPPING_PATH=llm_workflow/workflow_image_to_video_mapping.json
COMFYUI_VIDEO_JOB_TIMEOUT_SECONDS=400
MAX_VIDEO_LENGTH=161
MAX_UPLOAD_BYTES=15728640
MAX_EDIT_IMAGES=10

MAX_QUEUE_SIZE=20
MAX_PROMPT_LENGTH=2000
MAX_NEGATIVE_PROMPT_LENGTH=2000
MAX_WIDTH=1024
MAX_HEIGHT=1024
MAX_IMAGE_PIXELS=1048576
# Video: long≤800 short≤496 (500 aligned down to ×8) → 800×496 or 496×800
MAX_VIDEO_LONG_SIDE=800
MAX_VIDEO_SHORT_SIDE=496
MAX_STEPS=60
SIZE_MULTIPLE=8

# Local: true. Public/production: false
ENABLE_DOCS=true

# Orphan privacy purge: succeeded tasks older than N days (0 = disabled)
IMAGE_RETENTION_DAYS=7
RETENTION_SWEEP_INTERVAL_SECONDS=3600
# ComfyUI folders on the API host (required for deleting input/output files)
# Example: E:\ComfyUI\input  and  E:\ComfyUI\output
COMFY_INPUT_DIR=
COMFY_OUTPUT_DIR=

# Public showcase (作品展馆) + private cloud gallery — prefer cloud meta plane in production
SHOWCASE_DB_PATH=data/showcase.db
SHOWCASE_FILES_DIR=data/showcase
CLOUD_GALLERY_DB_PATH=data/cloud_gallery.db
CLOUD_GALLERY_FILES_DIR=data/cloud_gallery

# --- AI prompt polish gateway (Studio calls this; upstream key stays on server) ---
POLISH_ENABLED=false
POLISH_AI_BASE_URL=https://api.deepseek.com
POLISH_AI_API_KEY=
POLISH_AI_MODEL=deepseek-chat
POLISH_AI_TIMEOUT_SECONDS=60
# Legacy polish fingerprint quota (kept for compatibility; prefer per-user limits below)
POLISH_DAILY_LIMIT=200
POLISH_RATE_PER_MINUTE=20
POLISH_QUOTA_DB_PATH=data/polish_quota.db

# --- Multi-user (register → admin approve → auto API Key) ---
USERS_DB_PATH=data/users.db
DEFAULT_DAILY_GENERATE_LIMIT=50
DEFAULT_DAILY_POLISH_LIMIT=200
# Non-admin users that may hold a key (pool remaining = this - approved)
MAX_APPROVED_USERS=20
ACTIVE_USER_WINDOW_MINUTES=15
# First start: empty users.db imports .env API_KEY as admin (Gateway 管理用).

# Browser CORS allowlist (Web Studio / marketing / admin). Comma-separated; empty = disable CORS.
CORS_ORIGINS=https://comfy-studio.sharex.team,https://app.comfy-studio.sharex.team,https://comfy-gateway.sharex.team,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Host services (Gateway Web 远程启停 ComfyUI / FRP；需管理员登录) ---
HOST_SERVICES_ENABLED=true
# 桌面版：含 main.py；便携版：ComfyUI_windows_portable（或外层安装夹，会自动深入）
HOST_COMFY_DIR=
# 在解析后的目录执行；便携版可改用 python_embeded\python.exe -s ComfyUI\main.py ...（留默认也会按目录类型校正）
HOST_COMFY_LAUNCH=.venv\Scripts\python.exe main.py --listen 127.0.0.1 --port 8188
HOST_FRPC_PATH=
HOST_FRPC_CONFIG_PATH=

# --- User email (register / bind / password-reset) ---
# MAIL_DRY_RUN=true → 验证码打 API 日志，不真发邮件（默认 true）
MAIL_DRY_RUN=true
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_COOLDOWN_SECONDS=60
MAIL_DAILY_LIMIT=10
MAIL_OTP_TTL_SECONDS=300
EMAIL_RESET_DB_PATH=data/email_reset.db

# --- Gateway admin login (remote console at comfy-gateway.sharex.team) ---
# totp = password + Authenticator（推荐，无需短信资质）
# sms  = 手机短信 OTP（需腾讯云/阿里云签名模板审核）
ADMIN_LOGIN_MODE=totp
ADMIN_PASSWORD=
# base32 secret；生成：
#   .\.venv\Scripts\python.exe -c "from app.totp import generate_totp_secret, otpauth_uri; s=generate_totp_secret(); print(s); print(otpauth_uri(secret=s))"
# 把打印的 otpauth:// 用 Authenticator「扫码/手动输入」导入；SECRET 写入下行
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_SMS_DB_PATH=data/admin_sms.db
# --- SMS（仅 ADMIN_LOGIN_MODE=sms 时需要）---
ADMIN_PHONE=
SMS_COOLDOWN_SECONDS=60
SMS_DAILY_LIMIT=10
SMS_OTP_TTL_SECONDS=300
SMS_PROVIDER=tencent
SMS_DRY_RUN=false
SMS_SIGN_NAME=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_TEMPLATE_CODE=
SMS_REGION_ID=cn-hangzhou

